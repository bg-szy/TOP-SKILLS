# ============================================================
# TOP-SKILLS Configuration (Example)
# Copy to config.yaml and fill in your own values.
# ============================================================

sources:
  - repo: anthropics/skills
    branch: main
  - repo: trailofbits/skills
    branch: main
  - repo: robertguss/claude-code-toolkit
    branch: main
  - repo: YYH211/Claude-meta-skill
    branch: main
  - repo: OneWave-AI/claude-skills
    branch: main
  - repo: aiskillstore/marketplace
    branch: main
  - repo: Prat011/awesome-llm-skills
    branch: main
  - repo: FridrichMethod/awesome-skills
    branch: main
  - repo: obviousworks/Claude-AI-skills-collection-2026
    branch: main
  - repo: julianobarbosa/claude-code-skills
    branch: main
  - repo: PracticalSwan/agent-skills
    branch: main
  - repo: ariadoss/superskills
    branch: main
  - repo: karanb192/awesome-claude-skills
    branch: main

github:
  # Generate at https://github.com/settings/tokens (no scopes needed for public repos)
  token: ""
  search_queries:
    - "topic:claude-code-skill"
    - "topic:claude-skills"
    - "SKILL.md+claude+code+skills"
    - "claude-code+skill+SKILL.md"

verification:
  max_file_size: 10485760
  max_skill_size: 104857600
  allowed_extensions:
    - .md
    - .py
    - .js
    - .ts
    - .sh
    - .json
    - .yaml
    - .yml
    - .toml
    - .txt
    - .csv
    - .png
    - .jpg
    - .jpeg
    - .gif
    - .svg
    - .css
    - .html
    - .pdf
    - .drawio
  blocked_patterns:
    - "(?i)curl\\s+(?:-s|-k|-L)?\\s*\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
    - "(?i)wget\\s+(?:-q|-O)?\\s*\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
    - "(?i)(?:bash|sh|powershell|cmd)\\s+-c\\s+['\"]\\s*(?:curl|wget|iwr)"
    - "eval\\(\\s*(?:os\\.system|subprocess|exec|compile)"
    - "__import__\\s*\\(\\s*['\"]os['\"]\\s*\\)\\.system"
    - "base64.*decode.*\\b(?:bash|sh|python|powershell)"
    - "(?i)git\\s+clone\\s+https://raw\\.githubusercontent\\.com"

pipeline:
  max_skills_per_run: 500
  min_disk_gb: 5
  log_retention_days: 30
